# Virtual environment
.venv/
venv/
ENV/

# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# PyInstaller build & runtime outputs (built via build_exe.bat; release zip published in GitHub Releases)
build/
dist/
_internal/
/XiControl.exe

# Local archives & backups
/XiControl.zip
_backup_*/

# Logs
*.log

# PyInstaller writes this on every build, with paths of the PC it ran on
*.spec

# Settings, keys and anything read from a real device never belong here
config.json
config.json.*
